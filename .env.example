# Claude (AI extraction). Leave unset only for offline tests.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Zalo OA
ZALO_APP_ID=
ZALO_OA_SECRET_KEY=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_APP_SECRET=
# Zalo user_id of the Founder (only this user is accepted; empty = accept first sender and log warning)
FOUNDER_ZALO_USER_ID=

# Speech-to-text (Whisper-compatible /audio/transcriptions endpoint). Empty = voice is stored and Founder is asked to type.
STT_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# Storage & report
DATA_DIR=./data
TIMEZONE=Asia/Ho_Chi_Minh
DAILY_REPORT_TIME=21:30
# Public base URL of this service, used to send a download link of the XLSX report over Zalo
PUBLIC_BASE_URL=
REPORT_LINK_SECRET=change-me
